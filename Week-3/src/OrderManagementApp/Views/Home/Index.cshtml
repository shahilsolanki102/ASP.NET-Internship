@{
    ViewData["Title"] = "Week 3 - Automated Unit & Integration Testing Suite";
}

<!-- Hero -->
<div class="p-5 mb-5 rounded-5 text-white position-relative overflow-hidden" 
     style="background: radial-gradient(circle at top right, #1d4ed8, #0f172a 70%); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
    <div class="row align-items-center py-4">
        <div class="col-lg-8">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-15 mb-3">
                <span class="badge bg-primary rounded-pill px-2 py-1 small">Week 3</span>
                <span class="text-light small fw-semibold">Unit &amp; Integration Testing for ASP.NET Core</span>
            </div>
            
            <h1 class="display-4 fw-bolder mb-3 text-white">Automated Testing &amp; Quality Assurance Hub</h1>
            <p class="lead mb-4 text-light opacity-80" style="font-size: 1.15rem; max-width: 620px;">
                Comprehensive test coverage with xUnit, Moq, FluentAssertions, and WebApplicationFactory integration testing validating business rules, edge cases, and data integrity.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="TestDashboard" asp-action="Index" class="btn-modern-primary py-3 px-4 fs-6">
                    <i class="bi bi-patch-check-fill"></i> View Automated Test Suite
                </a>
                <a asp-controller="Order" asp-action="Create" class="btn btn-outline-light rounded-3 py-3 px-4 fw-semibold">
                    <i class="bi bi-plus-circle"></i> Create Test Order
                </a>
            </div>
        </div>

        <div class="col-lg-4 d-none d-lg-block text-center">
            <div class="p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur">
                <div class="display-3 fw-bolder text-success mb-1">100%</div>
                <h6 class="fw-bold text-white mb-2">Automated Test Pass Rate</h6>
                <p class="small text-light opacity-75 mb-0">20+ Unit &amp; Integration tests passing across domain services, inventory validation, and HTTP pipelines.</p>
            </div>
        </div>
    </div>
</div>

<!-- 4 Testing Pillars -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-primary-subtle text-primary mb-3">
                <i class="bi bi-box fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">xUnit Unit Testing</h5>
            <p class="text-body-secondary small mb-0">
                Isolated unit tests verifying subtotal calculations, customer tier discounts, and tax computations.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-info-subtle text-info mb-3">
                <i class="bi bi-layers-half fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">Moq Framework</h5>
            <p class="text-body-secondary small mb-0">
                Mocking external dependencies like notification emailers and repository services with strict invocations.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-success-subtle text-success mb-3">
                <i class="bi bi-hdd-network-fill fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">WebApplicationFactory</h5>
            <p class="text-body-secondary small mb-0">
                In-memory HTTP server executing end-to-end integration tests on routes, ModelState, and database persistence.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-warning-subtle text-warning mb-3">
                <i class="bi bi-shield-check fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">FluentAssertions</h5>
            <p class="text-body-secondary small mb-0">
                Readable assertion chains checking edge cases (out of stock, expired coupons, zero quantities).
            </p>
        </div>
    </div>
</div>
