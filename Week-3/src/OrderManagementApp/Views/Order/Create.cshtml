@model OrderManagementApp.ViewModels.CreateOrderViewModel
@{
    ViewData["Title"] = "Create Customer Order";
    var customers = ViewBag.Customers as List<OrderManagementApp.Models.Customer> ?? new();
    var items = ViewBag.Items as List<OrderManagementApp.Models.Item> ?? new();
    var coupons = ViewBag.Coupons as List<OrderManagementApp.Models.Coupon> ?? new();
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bolder mb-1 text-body">Create Customer Order</h3>
                <p class="text-body-secondary mb-0">Select a customer, add items, and apply optional promo coupons.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
        </div>

        <form asp-action="Create" method="post" class="modern-card p-4 p-md-5 bg-body">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 mb-4 small"></div>

            <!-- Customer Selection -->
            <div class="mb-4">
                <label asp-for="CustomerId" class="form-label fw-bold text-body small">Select Customer (Tier-based discounts apply automatically)</label>
                <select asp-for="CustomerId" class="form-select form-select-modern">
                    <option value="">-- Choose Customer --</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id">@c.Name (@c.Email) &bull; Tier: @c.Tier</option>
                    }
                </select>
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>

            <!-- Items Picker -->
            <div class="mb-4">
                <label class="form-label fw-bold text-body small">Order Items</label>
                <div class="p-3 bg-body-tertiary rounded-4 border">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-8">
                            <label class="form-label small text-muted">Item Catalog (Stock quantity verified automatically)</label>
                            <select name="Items[0].ItemId" class="form-select form-select-modern">
                                @foreach (var item in items)
                                {
                                    <option value="@item.Id">@item.Name &bull; SKU: @item.SKU &bull; $@item.UnitPrice.ToString("N2") (In Stock: @item.StockQuantity)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-muted">Quantity</label>
                            <input type="number" name="Items[0].Quantity" value="1" min="1" max="100" class="form-control form-control-modern" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Coupon Code -->
            <div class="mb-4">
                <label asp-for="CouponCode" class="form-label fw-bold text-body small">Coupon Promo Code (Optional)</label>
                <div class="input-group">
                    <span class="input-group-text bg-body-tertiary"><i class="bi bi-tag-fill text-primary"></i></span>
                    <input asp-for="CouponCode" class="form-control form-control-modern border-start-0" placeholder="e.g. WELCOME10 or SAVE25" />
                </div>
                <div class="text-muted mt-1" style="font-size: 0.78rem;">Available Active Coupons: <code>WELCOME10</code> (10% off), <code>SAVE25</code> (25% off min $300).</div>
            </div>

            <!-- Submit -->
            <div class="d-flex justify-content-end gap-3 pt-4 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button type="submit" class="btn-modern-primary px-5">
                    <i class="bi bi-cart-check"></i> Place Customer Order
                </button>
            </div>
        </form>
    </div>
</div>
