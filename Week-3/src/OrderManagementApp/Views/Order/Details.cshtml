@model OrderManagementApp.ViewModels.OrderSummaryViewModel
@{
    ViewData["Title"] = "Order Details #" + Model.OrderNumber;
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <!-- Action Buttons -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
            <button onclick="window.print();" class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-printer me-1"></i> Print Invoice
            </button>
        </div>

        <!-- Invoice Card -->
        <div class="modern-card p-4 p-md-5 bg-body mb-4">
            <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Order Completed
                        </span>
                    </div>
                    <h3 class="fw-bolder text-body mb-1">Invoice @Model.OrderNumber</h3>
                    <div class="text-muted small">Placed on @Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm:ss") UTC</div>
                </div>

                <div class="text-end">
                    <h6 class="fw-bold text-body mb-1">OrderFlow Inc.</h6>
                    <div class="text-muted small">support@orderflow.dev</div>
                </div>
            </div>

            <!-- Customer Details -->
            <div class="row g-3 mb-4 p-3 bg-body-tertiary rounded-4 border">
                <div class="col-md-6">
                    <div class="text-muted small">Billed To Customer:</div>
                    <div class="fw-bold text-body">@Model.CustomerName</div>
                    <div class="text-muted small">@Model.CustomerEmail</div>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="text-muted small">Customer Tier Level:</div>
                    <span class="badge bg-primary text-white rounded-pill px-3 py-1">@Model.CustomerTier Tier</span>
                    @if (!string.IsNullOrEmpty(Model.CouponCodeApplied))
                    {
                        <div class="text-muted small mt-1">Promo Applied: <code>@Model.CouponCodeApplied</code></div>
                    }
                </div>
            </div>

            <!-- Items Table -->
            <div class="table-responsive mb-4">
                <table class="table table-borderless align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr class="small text-uppercase fw-bold text-secondary">
                            <th>Item Description</th>
                            <th>SKU</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="border-bottom">
                                <td class="fw-semibold text-body">@item.ItemName</td>
                                <td class="code-font small text-muted">@item.SKU</td>
                                <td class="text-center fw-bold">@item.Quantity</td>
                                <td class="text-end code-font">$@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold text-body code-font">$@item.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Totals Breakdown -->
            <div class="row justify-content-end">
                <div class="col-md-5">
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        <li class="d-flex justify-content-between small">
                            <span class="text-muted">Subtotal:</span>
                            <span class="fw-bold text-body code-font">$@Model.Subtotal.ToString("N2")</span>
                        </li>
                        <li class="d-flex justify-content-between small text-danger">
                            <span>Discounts Applied:</span>
                            <span class="fw-bold code-font">-$@Model.DiscountAmount.ToString("N2")</span>
                        </li>
                        <li class="d-flex justify-content-between small text-muted">
                            <span>Sales Tax (8%):</span>
                            <span class="fw-bold code-font">+$@Model.TaxAmount.ToString("N2")</span>
                        </li>
                        <li class="d-flex justify-content-between pt-2 border-top fs-5 fw-bold text-success">
                            <span>Final Total:</span>
                            <span class="code-font">$@Model.TotalAmount.ToString("N2")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
