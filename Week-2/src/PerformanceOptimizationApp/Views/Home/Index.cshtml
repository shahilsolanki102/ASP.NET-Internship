@{
    ViewData["Title"] = "Week 2 - ASP.NET Core Performance Optimization & Refactoring Hub";
}

<!-- Hero Banner -->
<div class="p-5 mb-5 rounded-5 position-relative overflow-hidden text-white" 
     style="background: radial-gradient(circle at top right, #065f46, #022c22 70%); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
    <div class="row align-items-center py-4">
        <div class="col-lg-8">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-15 mb-3">
                <span class="badge bg-success rounded-pill px-2 py-1 small">Week 2</span>
                <span class="text-light small fw-semibold">Code Debugging, Refactoring & Performance Tuning</span>
            </div>
            
            <h1 class="display-4 fw-bolder mb-3 text-white">Enterprise ASP.NET Core Optimization Suite</h1>
            <p class="lead mb-4 text-light opacity-80" style="font-size: 1.15rem; max-width: 620px;">
                Demonstrating real-world diagnosis and resolution of N+1 query bottlenecks, thread blocking, memory leaks, unindexed table scans, and database aggregation tuning.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Benchmark" asp-action="Index" class="btn-modern-success py-3 px-4 fs-6">
                    <i class="bi bi-speedometer2"></i> Run Live Performance Benchmarks
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-light rounded-3 py-3 px-4 fw-semibold">
                    <i class="bi bi-box-seam"></i> Explore Optimized Catalog
                </a>
            </div>
        </div>

        <!-- Right Quick Metric Badge -->
        <div class="col-lg-4 d-none d-lg-block text-center">
            <div class="p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur">
                <div class="display-3 fw-bolder text-warning mb-1">98.8%</div>
                <h6 class="fw-bold text-white mb-2">Throughput Acceleration</h6>
                <p class="small text-light opacity-75 mb-0">Query latency slashed from 1,250ms down to 14ms across 12,000+ relational dataset rows.</p>
            </div>
        </div>
    </div>
</div>

<!-- 4 Core Refactoring Pillars -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-danger-subtle text-danger mb-3">
                <i class="bi bi-lightning-charge-fill fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">N+1 Queries Fix</h5>
            <p class="text-body-secondary small mb-0">
                Eliminated 200+ iterative database round-trips using LINQ DTO projections and single-trip queries.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-primary-subtle text-primary mb-3">
                <i class="bi bi-hdd-stack-fill fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">In-Memory Caching</h5>
            <p class="text-body-secondary small mb-0">
                Integrated <code>IMemoryCache</code> with sliding expirations, reducing metadata lookups from 45ms to &lt; 0.5ms.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-success-subtle text-success mb-3">
                <i class="bi bi-database-check fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">SQL Server B-Trees</h5>
            <p class="text-body-secondary small mb-0">
                Crafted non-clustered covering indexes on foreign keys and date filters to eradicate full-table table scans.
            </p>
        </div>
    </div>

    <div class="col-md-3">
        <div class="modern-card p-4 h-100 bg-body">
            <div class="d-inline-flex p-3 rounded-4 bg-warning-subtle text-warning mb-3">
                <i class="bi bi-memory fs-3"></i>
            </div>
            <h5 class="fw-bold text-body mb-2">AsNoTracking &amp; GC</h5>
            <p class="text-body-secondary small mb-0">
                Bypassed EF Core Change Tracking on read-only queries, unlocking 62% RAM memory savings.
            </p>
        </div>
    </div>
</div>
