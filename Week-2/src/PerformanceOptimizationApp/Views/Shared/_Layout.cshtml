<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SpeedTuner &bull; ASP.NET Core Performance Hub</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
    <!-- Chart.js for Benchmark Visuals -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --brand-gradient: linear-gradient(135deg, #059669 0%, #10b981 50%, #06b6d4 100%);
            --card-border: rgba(226, 232, 240, 0.8);
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
        }

        [data-bs-theme="dark"] {
            --card-border: rgba(51, 65, 85, 0.8);
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            letter-spacing: -0.01em;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-glass {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .brand-logo-badge {
            width: 38px;
            height: 38px;
            background: var(--brand-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.35);
        }

        .nav-link-custom {
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.15s ease;
        }

        .btn-modern-success {
            background: var(--brand-gradient);
            color: #ffffff !important;
            border: none;
            font-weight: 600;
            padding: 10px 22px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-modern-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
            opacity: 0.96;
        }

        .modern-card {
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: var(--card-shadow);
        }

        .code-font {
            font-family: 'JetBrains Mono', monospace;
        }

        footer {
            margin-top: auto;
            border-top: 1px solid var(--card-border);
        }
    </style>
</head>
<body class="bg-body-tertiary text-body">
    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-glass py-3 bg-body bg-opacity-75">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bolder text-body" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-badge">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <span class="fs-5 fw-bold">Speed<span style="color: #10b981;">Tuner</span></span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill ms-1 px-2 py-1 small" style="font-size: 0.7rem;">Week 2 Tuning</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Overview
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Benchmark" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1 text-danger"></i> Live Benchmarks
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam me-1 text-primary"></i> Optimized Catalog
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Products" asp-action="TopSelling">
                                <i class="bi bi-graph-up-arrow me-1 text-success"></i> Sales Analytics
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center" 
                                id="themeToggleBtn" onclick="toggleTheme();" style="width: 36px; height: 36px;" title="Toggle Dark/Light Theme">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>
                        <a asp-controller="Benchmark" asp-action="Index" class="btn-modern-success">
                            <i class="bi bi-play-fill"></i> Run Benchmarks
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-5 bg-body">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-logo-badge" style="width: 28px; height: 28px; font-size: 0.9rem;">
                    <i class="bi bi-lightning-fill"></i>
                </div>
                <span class="fw-bold text-body">SpeedTuner</span>
                <span class="text-muted small">&bull; ASP.NET Core 9 Performance Optimization Suite</span>
            </div>
            <div class="text-muted small">
                Developed by <strong class="text-body">Shahil</strong> &bull; Yuva Intern / NSDC Week 2
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function initTheme() {
            const savedTheme = localStorage.getItem('theme_w2') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            updateThemeIcon(savedTheme);
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme_w2', newTheme);
            updateThemeIcon(newTheme);
        }

        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (icon) {
                icon.className = theme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars-fill text-dark';
            }
        }

        initTheme();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
