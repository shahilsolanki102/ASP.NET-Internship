<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProfileX &bull; Modern ASP.NET Core MVC</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Inter / Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        :root {
            --brand-primary: #6366f1;
            --brand-primary-hover: #4f46e5;
            --brand-secondary: #06b6d4;
            --brand-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
            --brand-gradient-subtle: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
            --card-border: rgba(226, 232, 240, 0.8);
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
        }

        [data-bs-theme="dark"] {
            --card-border: rgba(51, 65, 85, 0.8);
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            letter-spacing: -0.01em;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Glassmorphism Navbar */
        .navbar-glass {
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--card-border);
            position: sticky;
            top: 0;
            z-index: 1030;
            transition: all 0.2s ease;
        }

        .brand-logo-badge {
            width: 38px;
            height: 38px;
            background: var(--brand-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.35);
        }

        .nav-link-custom {
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.15s ease;
        }

        .btn-modern-primary {
            background: var(--brand-gradient);
            color: #ffffff !important;
            border: none;
            font-weight: 600;
            padding: 10px 22px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-modern-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
            opacity: 0.96;
        }

        .btn-modern-secondary {
            border: 1px solid var(--card-border);
            font-weight: 600;
            padding: 9px 20px;
            border-radius: 12px;
            transition: all 0.15s ease;
        }

        .modern-card {
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }

        .user-nav-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #818cf8;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .form-control-modern, .form-select-modern {
            border: 1.5px solid var(--card-border);
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .form-control-modern:focus, .form-select-modern:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            outline: none;
        }

        footer {
            margin-top: auto;
            border-top: 1px solid var(--card-border);
        }
    </style>
</head>
<body class="bg-body-tertiary text-body">
    <!-- Top Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-glass py-3 bg-body bg-opacity-75">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bolder text-body" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-badge">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                    <span class="fs-5 fw-bold">Profile<span style="color: #6366f1;">X</span></span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill ms-1 px-2 py-1 small" style="font-size: 0.7rem;">v2.6 Enterprise</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-fill me-1 text-primary"></i> Dashboard
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-badge-fill me-1 text-primary"></i> My Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-custom text-body-secondary text-decoration-none" asp-controller="Profile" asp-action="Edit">
                                    <i class="bi bi-sliders me-1 text-primary"></i> Settings
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Dark / Light Mode Switcher -->
                        <button class="btn btn-sm btn-outline-secondary rounded-circle p-2 d-flex align-items-center justify-content-center" 
                                id="themeToggleBtn" onclick="toggleTheme();" style="width: 36px; height: 36px;" title="Toggle Dark / Light Theme">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var avatarUrl = User.FindFirst("AvatarUrl")?.Value ?? "/images/default-avatar.png";
                            <div class="dropdown">
                                <button class="btn d-flex align-items-center gap-2 bg-body-secondary rounded-pill px-3 py-1 border shadow-sm dropdown-toggle" 
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatarUrl" alt="Avatar" class="user-nav-avatar" onerror="this.src='/images/default-avatar.png'" />
                                    <span class="fw-bold small text-body d-none d-sm-inline">@User.Identity.Name</span>
                                    <span class="badge bg-success border border-white rounded-circle p-1" style="width: 8px; height: 8px;"></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="min-width: 230px;">
                                    <li class="px-3 py-2 border-bottom mb-1">
                                        <div class="fw-bold text-body">@User.Identity.Name</div>
                                        <div class="text-muted small text-truncate">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    </li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2 text-primary"></i> View Profile</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="Edit"><i class="bi bi-gear me-2 text-primary"></i> Edit Profile</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="ChangePassword"><i class="bi bi-shield-check me-2 text-primary"></i> Security & 2FA</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="ExportSummary" target="_blank"><i class="bi bi-printer me-2 text-success"></i> Download Resume PDF</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item rounded-3 py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i> Log Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link-custom text-body fw-bold px-3 text-decoration-none" asp-controller="Account" asp-action="Login">
                                Sign In
                            </a>
                            <a class="btn-modern-primary" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-stars"></i> Get Started
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <div class="container my-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-5 bg-body">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-logo-badge" style="width: 28px; height: 28px; font-size: 0.9rem;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <span class="fw-bold text-body">ProfileX</span>
                <span class="text-muted small">&bull; ASP.NET Core 9 MVC Architecture</span>
            </div>
            <div class="text-muted small">
                Developed by <strong class="text-body">Shahil</strong> &bull; Yuva Intern / NSDC Project
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Dark / Light Theme Logic
        function initTheme() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
            updateThemeIcon(savedTheme);
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeIcon(newTheme);
        }

        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (icon) {
                if (theme === 'dark') {
                    icon.className = 'bi bi-sun-fill text-warning';
                } else {
                    icon.className = 'bi bi-moon-stars-fill text-dark';
                }
            }
        }

        initTheme();

        // Toast notifications
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                timer: 3500,
                timerProgressBar: true,
                toast: true,
                position: 'top-end',
                showConfirmButton: false
            });
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            Swal.fire({
                icon: 'error',
                title: 'Attention',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                timer: 4000,
                timerProgressBar: true,
                toast: true,
                position: 'top-end',
                showConfirmButton: false
            });
            </text>
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
