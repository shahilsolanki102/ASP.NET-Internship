<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProfileX &bull; Modern ASP.NET Core MVC</title>

    <!-- Bootstrap 5.3.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Inter / Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <style>
        :root {
            --brand-primary: #6366f1;
            --brand-primary-hover: #4f46e5;
            --brand-secondary: #06b6d4;
            --brand-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
            --brand-gradient-subtle: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
            --dark-surface: #0f172a;
            --card-border: rgba(226, 232, 240, 0.8);
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
            --card-hover: 0 20px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        }

        body {
            font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            letter-spacing: -0.01em;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Glassmorphism Navbar */
        .navbar-glass {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            position: sticky;
            top: 0;
            z-index: 1030;
            transition: all 0.2s ease;
        }

        .brand-logo-badge {
            width: 38px;
            height: 38px;
            background: var(--brand-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(99, 102, 241, 0.35);
        }

        .nav-link-custom {
            font-weight: 600;
            color: #475569;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.15s ease;
        }

        .nav-link-custom:hover {
            color: var(--brand-primary);
            background: rgba(99, 102, 241, 0.06);
        }

        .nav-link-custom.active {
            color: var(--brand-primary);
            background: rgba(99, 102, 241, 0.1);
        }

        .btn-modern-primary {
            background: var(--brand-gradient);
            color: #ffffff !important;
            border: none;
            font-weight: 600;
            padding: 10px 22px;
            border-radius: 12px;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-modern-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
            opacity: 0.96;
        }

        .btn-modern-primary:active {
            transform: translateY(0);
        }

        .btn-modern-secondary {
            background: #ffffff;
            color: #334155;
            border: 1px solid #e2e8f0;
            font-weight: 600;
            padding: 9px 20px;
            border-radius: 12px;
            transition: all 0.15s ease;
        }

        .btn-modern-secondary:hover {
            background: #f1f5f9;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        .modern-card {
            background: #ffffff;
            border: 1px solid var(--card-border);
            border-radius: 20px;
            box-shadow: var(--card-shadow);
            transition: box-shadow 0.2s ease, transform 0.2s ease;
        }

        .user-nav-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #818cf8;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .badge-gradient {
            background: var(--brand-gradient);
            color: white;
            font-weight: 600;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.78rem;
            letter-spacing: 0.02em;
        }

        .form-control-modern, .form-select-modern {
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 14px;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            background-color: #fbfcfe;
        }

        .form-control-modern:focus, .form-select-modern:focus {
            background-color: #ffffff;
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
            outline: none;
        }

        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid #e2e8f0;
        }
    </style>
</head>
<body>
    <!-- Top Navigation -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-glass py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bolder text-dark" asp-controller="Home" asp-action="Index">
                    <div class="brand-logo-badge">
                        <i class="bi bi-person-fill-gear"></i>
                    </div>
                    <span class="fs-5 fw-bold">Profile<span style="color: #6366f1;">X</span></span>
                    <span class="badge bg-dark-subtle text-dark-emphasis rounded-pill ms-1 px-2 py-1 small" style="font-size: 0.7rem;">v2.6 SaaS</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto ms-lg-4 mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-fill me-1"></i> Dashboard
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link-custom" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-badge-fill me-1"></i> My Profile
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-custom" asp-controller="Profile" asp-action="Edit">
                                    <i class="bi bi-sliders me-1"></i> Settings
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var avatarUrl = User.FindFirst("AvatarUrl")?.Value ?? "/images/default-avatar.png";
                            <div class="dropdown">
                                <button class="btn d-flex align-items-center gap-2 bg-light rounded-pill px-3 py-1 border border-1 shadow-sm dropdown-toggle" 
                                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="@avatarUrl" alt="Avatar" class="user-nav-avatar" onerror="this.src='/images/default-avatar.png'" />
                                    <span class="fw-bold small text-dark d-none d-sm-inline">@User.Identity.Name</span>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-circle p-1" style="width: 8px; height: 8px;"></span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="min-width: 220px;">
                                    <li class="px-3 py-2 border-bottom mb-1">
                                        <div class="fw-bold text-dark">@User.Identity.Name</div>
                                        <div class="text-muted small text-truncate">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</div>
                                    </li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2 text-primary"></i> View Profile</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="Edit"><i class="bi bi-gear me-2 text-primary"></i> Edit Profile</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Profile" asp-action="ChangePassword"><i class="bi bi-shield-check me-2 text-primary"></i> Security</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item rounded-3 py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i> Log Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="nav-link-custom text-dark fw-bold px-3" asp-controller="Account" asp-action="Login">
                                Sign In
                            </a>
                            <a class="btn-modern-primary" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-stars"></i> Get Started
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4 p-3" role="alert" style="background: #ecfdf5; color: #065f46;">
                <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm d-flex align-items-center mb-4 p-3" role="alert" style="background: #fef2f2; color: #991b1b;">
                <i class="bi bi-exclamation-octagon-fill me-2 fs-5 text-danger"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-5">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-logo-badge" style="width: 28px; height: 28px; font-size: 0.9rem;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <span class="fw-bold text-dark">ProfileX</span>
                <span class="text-muted small">&bull; ASP.NET Core 9 MVC Enterprise Architecture</span>
            </div>
            <div class="text-muted small">
                Developed by <strong class="text-dark">Shahil</strong> &bull; Yuva Intern / NSDC Project
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
