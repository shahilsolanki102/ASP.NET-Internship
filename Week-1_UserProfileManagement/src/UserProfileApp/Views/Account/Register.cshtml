@model UserProfileApp.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account - ProfileX";
}

<div class="row justify-content-center align-items-center min-vh-75 py-4">
    <div class="col-lg-10 col-xl-9">
        <div class="modern-card overflow-hidden shadow-lg border-0">
            <div class="row g-0">
                <!-- Left Column: Branding Showcase -->
                <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-5 text-white position-relative" 
                     style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div class="brand-logo-badge">
                                <i class="bi bi-person-fill-gear"></i>
                            </div>
                            <span class="fs-4 fw-bolder text-white">Profile<span style="color: #a855f7;">X</span></span>
                        </div>
                        <h3 class="fw-bold text-white mb-3">Join ProfileX Platform</h3>
                        <p class="text-light opacity-75 small mb-4">
                            Set up your professional identity, showcase your skills, and manage your account seamlessly.
                        </p>
                    </div>

                    <div class="p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-10 backdrop-blur">
                        <div class="d-flex align-items-center gap-2 text-warning mb-1 small">
                            <i class="bi bi-check-circle-fill"></i>
                            <span class="fw-bold">Fast & Free Registration</span>
                        </div>
                        <p class="small text-light opacity-90 mb-0">
                            Instant access to the complete User Profile & Security suite.
                        </p>
                    </div>
                </div>

                <!-- Right Column: Registration Form -->
                <div class="col-md-7 p-4 p-lg-5 bg-white">
                    <div class="mb-4">
                        <h4 class="fw-bolder text-dark mb-1">Create an account</h4>
                        <p class="text-secondary small mb-0">Enter your details to create a new ProfileX account.</p>
                    </div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold text-dark small"></label>
                            <input asp-for="FullName" class="form-control form-control-modern" placeholder="e.g. Shahil Patel" autofocus />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="Username" class="form-label fw-bold text-dark small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted small">@@</span>
                                    <input asp-for="Username" class="form-control form-control-modern border-start-0" placeholder="username" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Email" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Email" type="email" class="form-control form-control-modern" placeholder="name@domain.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="Password" type="password" class="form-control form-control-modern" placeholder="••••••••" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold text-dark small"></label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-modern" placeholder="••••••••" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn-modern-primary py-2 fs-6">
                                Create Account <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>

                        <div class="text-center text-muted small">
                            Already have an account? 
                            <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Sign In</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
