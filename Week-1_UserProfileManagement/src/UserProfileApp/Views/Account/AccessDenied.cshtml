@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="custom-card p-5">
            <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">You do not have sufficient permissions to view this resource.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house me-1"></i> Return Home
            </a>
        </div>
    </div>
</div>
