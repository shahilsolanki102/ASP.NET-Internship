@model UserProfileApp.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In - ProfileX";
}

<div class="row justify-content-center align-items-center min-vh-75 py-4">
    <div class="col-lg-10 col-xl-9">
        <div class="modern-card overflow-hidden shadow-lg border-0">
            <div class="row g-0">
                <!-- Left Column: Branding Showcase -->
                <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-5 text-white position-relative" 
                     style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-4">
                            <div class="brand-logo-badge">
                                <i class="bi bi-person-fill-gear"></i>
                            </div>
                            <span class="fs-4 fw-bolder text-white">Profile<span style="color: #a855f7;">X</span></span>
                        </div>
                        <h3 class="fw-bold text-white mb-3">Enterprise-Grade Identity & Profile Management</h3>
                        <p class="text-light opacity-75 small mb-4">
                            Built with ASP.NET Core 9 MVC, SQL Server, and modern security best practices.
                        </p>
                    </div>

                    <div class="p-3 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-10 backdrop-blur">
                        <div class="d-flex align-items-center gap-2 text-warning mb-1 small">
                            <i class="bi bi-shield-check"></i>
                            <span class="fw-bold">Security Standard</span>
                        </div>
                        <p class="small text-light opacity-90 mb-0">
                            Equipped with SHA-256 cryptographic hashing, Anti-CSRF verification, and 2FA capability.
                        </p>
                    </div>
                </div>

                <!-- Right Column: Login Form -->
                <div class="col-md-7 p-4 p-lg-5 bg-white">
                    <div class="mb-4">
                        <h4 class="fw-bolder text-dark mb-1">Welcome back</h4>
                        <p class="text-secondary small mb-0">Sign in to manage your professional profile & settings.</p>
                    </div>

                    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3 small"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-dark small"></label>
                            <input asp-for="Email" class="form-control form-control-modern" placeholder="name@company.com" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Password" class="form-label fw-bold text-dark small mb-0"></label>
                            </div>
                            <div class="input-group">
                                <input asp-for="Password" type="password" id="passwordInput" class="form-control form-control-modern border-end-0" placeholder="••••••••" />
                                <button class="btn btn-outline-secondary border border-start-0 rounded-end-3 bg-light" type="button" onclick="togglePasswordVisibility('passwordInput', 'toggleEyeIcon');">
                                    <i id="toggleEyeIcon" class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label text-secondary small"></label>
                            </div>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn-modern-primary py-2 fs-6">
                                Sign In to Account <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>

                        <div class="text-center text-muted small">
                            Don't have an account? 
                            <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Create an account</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            }
        }
    </script>
}
