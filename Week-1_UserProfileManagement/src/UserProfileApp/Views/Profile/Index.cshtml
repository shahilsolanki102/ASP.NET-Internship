@model UserProfileApp.ViewModels.ProfileDetailsViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Top Profile Banner & Card -->
        <div class="custom-card mb-4 overflow-hidden position-relative">
            <div style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); height: 140px;" class="w-100 position-relative">
                <span class="badge bg-white text-primary position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm fw-semibold">
                    <i class="bi bi-patch-check-fill text-primary me-1"></i> Active Member
                </span>
            </div>
            
            <div class="p-4 pt-0">
                <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end justify-content-between mt-n5 pb-3 border-bottom gap-3">
                    <div class="d-flex flex-column flex-md-row align-items-center align-items-md-end gap-3 text-center text-md-start" style="margin-top: -60px;">
                        <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" 
                             class="rounded-circle shadow-lg border border-4 border-white bg-white" 
                             style="width: 120px; height: 120px; object-fit: cover;"
                             onerror="this.src='/images/default-avatar.png'" />
                        <div>
                            <h3 class="fw-bold mb-1">@Model.FullName</h3>
                            <p class="text-muted mb-0 d-flex align-items-center justify-content-center justify-content-md-start gap-2 flex-wrap">
                                <span><i class="bi bi-envelope me-1 text-primary"></i> @Model.Email</span>
                                <span>&bull;</span>
                                <span><i class="bi bi-person-badge me-1 text-secondary"></i> @@@Model.Username</span>
                                <span>&bull;</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">@Model.Role</span>
                            </p>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" class="btn btn-gradient px-3 py-2 rounded-pill shadow-sm d-flex align-items-center gap-1">
                            <i class="bi bi-pencil-square"></i>
                            <span>Edit Profile</span>
                        </a>
                        <a asp-action="ChangePassword" class="btn btn-outline-secondary px-3 py-2 rounded-pill d-flex align-items-center gap-1">
                            <i class="bi bi-shield-lock"></i>
                            <span>Security</span>
                        </a>
                    </div>
                </div>

                <!-- Profile Information Grid -->
                <div class="row g-4 mt-2">
                    <!-- Left Column: Bio & Personal Details -->
                    <div class="col-md-7">
                        <div class="p-3 bg-light rounded-4 mb-4">
                            <h6 class="fw-bold text-uppercase text-secondary small mb-3">
                                <i class="bi bi-card-text me-1 text-primary"></i> About Me
                            </h6>
                            <p class="text-dark mb-0 lh-base">
                                @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio provided yet. Click 'Edit Profile' to share a brief description about yourself." : Model.Bio)
                            </p>
                        </div>

                        <div class="p-3 bg-light rounded-4">
                            <h6 class="fw-bold text-uppercase text-secondary small mb-3">
                                <i class="bi bi-geo-alt me-1 text-primary"></i> Address & Location
                            </h6>
                            <div class="row g-3 small">
                                <div class="col-12">
                                    <span class="text-muted d-block">Street Address:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not specified" : Model.Address)</span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">City:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.City) ? "Not specified" : Model.City)</span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">State / Province:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.State) ? "Not specified" : Model.State)</span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Country:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Country) ? "Not specified" : Model.Country)</span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted d-block">Postal Code:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PostalCode) ? "Not specified" : Model.PostalCode)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Personal & Account Summary -->
                    <div class="col-md-5">
                        <div class="p-3 bg-light rounded-4 mb-4">
                            <h6 class="fw-bold text-uppercase text-secondary small mb-3">
                                <i class="bi bi-person-lines-fill me-1 text-primary"></i> Personal Details
                            </h6>
                            <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Phone Number:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</span>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Date of Birth:</span>
                                    <span class="fw-semibold">@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd MMM yyyy") : "Not set")</span>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Gender:</span>
                                    <span class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.Gender) ? "Not set" : Model.Gender)</span>
                                </li>
                            </ul>
                        </div>

                        <div class="p-3 bg-light rounded-4">
                            <h6 class="fw-bold text-uppercase text-secondary small mb-3">
                                <i class="bi bi-clock-history me-1 text-primary"></i> Account Timestamps
                            </h6>
                            <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Member Since:</span>
                                    <span class="fw-semibold">@Model.AccountCreatedAt.ToString("MMM dd, yyyy")</span>
                                </li>
                                <li class="d-flex justify-content-between py-1 border-bottom">
                                    <span class="text-muted">Last Profile Update:</span>
                                    <span class="fw-semibold">@Model.ProfileUpdatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                </li>
                                <li class="d-flex justify-content-between py-1">
                                    <span class="text-muted">Last Login:</span>
                                    <span class="fw-semibold">@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("MMM dd, yyyy HH:mm") : "Recently")</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
