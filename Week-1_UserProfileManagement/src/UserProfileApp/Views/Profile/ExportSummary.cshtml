@model UserProfileApp.ViewModels.ProfileDetailsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.FullName - Profile Summary</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            padding: 40px 20px;
        }
        .resume-sheet {
            max-width: 800px;
            margin: auto;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            padding: 40px;
            border: 1px solid #e2e8f0;
        }
        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .resume-sheet {
                box-shadow: none;
                border: none;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
        }
        .section-title {
            color: #4f46e5;
            font-weight: 700;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 2px solid #e0e7ff;
            padding-bottom: 6px;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>
    <div class="container text-center mb-4 no-print">
        <button onclick="window.print();" class="btn btn-primary rounded-pill px-4 shadow-sm me-2">
            <i class="bi bi-printer me-1"></i> Print / Save as PDF
        </button>
        <a href="/Profile" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Back to App
        </a>
    </div>

    <div class="resume-sheet">
        <!-- Header -->
        <div class="d-flex align-items-center gap-4 pb-4 border-bottom mb-4">
            <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" 
                 style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #6366f1;" 
                 onerror="this.src='/images/default-avatar.png'" />
            <div class="flex-grow-1">
                <h2 class="fw-bold mb-1 text-dark">@Model.FullName</h2>
                <h5 class="text-primary fw-semibold mb-2">@Model.Headline</h5>
                <div class="small text-muted d-flex flex-wrap gap-3">
                    <span><i class="bi bi-envelope"></i> @Model.Email</span>
                    <span><i class="bi bi-telephone"></i> @(string.IsNullOrEmpty(Model.PhoneNumber) ? "+91 98765 43210" : Model.PhoneNumber)</span>
                    <span><i class="bi bi-geo-alt"></i> @Model.City, @Model.Country</span>
                </div>
            </div>
        </div>

        <!-- Professional Summary -->
        <div class="mb-4">
            <div class="section-title"><i class="bi bi-file-earmark-person me-2"></i> Professional Summary</div>
            <p class="text-secondary lh-base mb-0">@Model.Bio</p>
        </div>

        <!-- Technical Skills -->
        <div class="mb-4">
            <div class="section-title"><i class="bi bi-code-slash me-2"></i> Core Competencies & Skills</div>
            <div class="d-flex flex-wrap gap-2">
                @if (!string.IsNullOrWhiteSpace(Model.Skills))
                {
                    foreach (var s in Model.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="badge bg-light text-dark border px-3 py-2" style="font-size: 0.85rem;">@s</span>
                    }
                }
            </div>
        </div>

        <!-- Online Presence -->
        <div class="mb-4">
            <div class="section-title"><i class="bi bi-globe me-2"></i> Portfolios & Links</div>
            <div class="row g-2 small">
                @if (!string.IsNullOrEmpty(Model.GitHubUrl))
                {
                    <div class="col-6"><strong>GitHub:</strong> @Model.GitHubUrl</div>
                }
                @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                {
                    <div class="col-6"><strong>LinkedIn:</strong> @Model.LinkedInUrl</div>
                }
                @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                {
                    <div class="col-6"><strong>Website:</strong> @Model.WebsiteUrl</div>
                }
            </div>
        </div>

        <!-- System & Security Info -->
        <div class="pt-3 border-top text-muted small d-flex justify-content-between">
            <span>ProfileX Verified Identity &bull; ASP.NET Core 9 MVC Architecture</span>
            <span>Generated on: @DateTime.UtcNow.ToString("dd MMM yyyy")</span>
        </div>
    </div>
</body>
</html>
