@{
    ViewData["Title"] = "Enterprise Profile & Identity Management System";
}

<!-- Hero Section -->
<div class="p-5 mb-5 rounded-5 position-relative overflow-hidden text-white" 
     style="background: radial-gradient(circle at top right, #312e81, #0f172a 70%); border: 1px solid rgba(255, 255, 255, 0.1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
    <div class="row align-items-center py-4">
        <div class="col-lg-7">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-15 mb-3">
                <span class="badge bg-primary rounded-pill px-2 py-1 small">ASP.NET 9</span>
                <span class="text-light small fw-semibold">Yuva Intern / NSDC &bull; Week 1 Milestone</span>
            </div>
            
            <h1 class="display-4 fw-bolder mb-3 text-white">Next-Gen User Profile & Identity Architecture</h1>
            <p class="lead mb-4 text-light opacity-80" style="font-size: 1.15rem; max-width: 580px;">
                A production-ready, enterprise-grade ASP.NET Core MVC web application with custom service patterns, SQL Server relational database, 2FA security, and modern UI.
            </p>

            <div class="d-flex flex-wrap gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="Index" class="btn-modern-primary py-3 px-4 fs-6">
                        <i class="bi bi-person-badge-fill"></i> Go to Live Profile Dashboard
                    </a>
                    <a asp-controller="Profile" asp-action="Edit" class="btn-modern-secondary py-3 px-4">
                        <i class="bi bi-sliders"></i> Edit Settings
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-modern-primary py-3 px-4 fs-6">
                        <i class="bi bi-box-arrow-in-right"></i> Sign In to Account
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn-modern-secondary py-3 px-4">
                        <i class="bi bi-stars"></i> Create Account
                    </a>
                }
            </div>
        </div>

        <!-- Right Side Live Interactive Preview Card -->
        <div class="col-lg-5 d-none d-lg-block mt-4 mt-lg-0">
            <div class="p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 backdrop-blur shadow-2xl">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="p-2 rounded-3 bg-primary text-white"><i class="bi bi-person-fill"></i></span>
                        <span class="fw-bold text-white small">Profile Preview</span>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">90% Complete</span>
                </div>

                <div class="d-flex align-items-center gap-3 mb-3 p-2 rounded-3 bg-dark bg-opacity-50">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&auto=format&fit=crop&q=80" 
                         alt="Preview" class="rounded-circle border border-2 border-white" style="width: 50px; height: 50px; object-fit: cover;" />
                    <div>
                        <div class="fw-bold text-white mb-0">Shahil Patel</div>
                        <div class="text-light opacity-75 small">ASP.NET Core Full-Stack Engineer</div>
                    </div>
                </div>

                <div class="small text-light opacity-75 mb-2">Technical Skills</div>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <span class="badge bg-white bg-opacity-15 text-white border border-white border-opacity-10">C#</span>
                    <span class="badge bg-white bg-opacity-15 text-white border border-white border-opacity-10">ASP.NET Core MVC</span>
                    <span class="badge bg-white bg-opacity-15 text-white border border-white border-opacity-10">SQL Server</span>
                    <span class="badge bg-white bg-opacity-15 text-white border border-white border-opacity-10">EF Core</span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-white border-opacity-10 small text-light opacity-80">
                    <span><i class="bi bi-shield-check text-success"></i> 2FA Enabled</span>
                    <span><i class="bi bi-clock"></i> Active Now</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Architecture Features Grid -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="modern-card p-4 h-100">
            <div class="d-inline-flex p-3 rounded-4 bg-primary-subtle text-primary mb-3">
                <i class="bi bi-person-workspace fs-3"></i>
            </div>
            <h5 class="fw-bolder text-dark mb-2">Rich Profile Management</h5>
            <p class="text-secondary small mb-0">
                Custom avatar and cover banner upload, biography, skills tags, social links (GitHub, LinkedIn, Twitter), and profile completion meter.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="modern-card p-4 h-100">
            <div class="d-inline-flex p-3 rounded-4 bg-success-subtle text-success mb-3">
                <i class="bi bi-shield-lock-fill fs-3"></i>
            </div>
            <h5 class="fw-bolder text-dark mb-2">Enterprise Security Suite</h5>
            <p class="text-secondary small mb-0">
                Two-Factor Authentication (2FA) toggle, SHA-256 cryptographic password hashing, Anti-CSRF verification, and safe image validation.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="modern-card p-4 h-100">
            <div class="d-inline-flex p-3 rounded-4 bg-info-subtle text-info mb-3">
                <i class="bi bi-activity fs-3"></i>
            </div>
            <h5 class="fw-bolder text-dark mb-2">Audit Logs & Active Sessions</h5>
            <p class="text-secondary small mb-0">
                Real-time activity audit timeline logging profile edits, password updates, and a multi-device active session manager.
            </p>
        </div>
    </div>
</div>

<!-- Tech Stack Bar -->
<div class="modern-card p-4 text-center">
    <div class="fw-bold text-secondary small text-uppercase mb-3">Enterprise Tech Stack & Standards</div>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-code-slash text-primary me-1"></i> C# .NET 9.0</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-window-fullscreen text-primary me-1"></i> ASP.NET Core MVC</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-database text-danger me-1"></i> Microsoft SQL Server</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-layers text-success me-1"></i> Entity Framework Core 9</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-bootstrap-fill text-purple me-1"></i> Bootstrap 5.3 & Icons</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-git text-warning me-1"></i> Git Version Control</span>
    </div>
</div>
