@{
    ViewData["Title"] = "ASP.NET MVC User Profile Management Module";
}

<!-- Hero Section -->
<div class="p-5 mb-5 rounded-4 position-relative overflow-hidden text-white" style="background: linear-gradient(135deg, #312e81 0%, #4338ca 50%, #6366f1 100%);">
    <div class="row align-items-center py-3">
        <div class="col-lg-8">
            <span class="badge bg-white text-primary mb-3 px-3 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-award-fill me-1 text-warning"></i> Yuva Intern / NSDC &bull; Week 1 Project
            </span>
            <h1 class="display-5 fw-bold mb-3">Enterprise User Profile Management Module</h1>
            <p class="lead mb-4 text-light opacity-90">
                A full-stack, secure web module built with <strong>ASP.NET Core MVC</strong>, <strong>Entity Framework Core</strong>, <strong>Microsoft SQL Server</strong>, and <strong>Bootstrap 5</strong>.
            </p>
            <div class="d-flex flex-wrap gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Profile" asp-action="Index" class="btn btn-light text-primary fw-bold px-4 py-3 rounded-pill shadow">
                        <i class="bi bi-person-circle me-1"></i> Go to My Profile
                    </a>
                    <a asp-controller="Profile" asp-action="Edit" class="btn btn-outline-light fw-semibold px-4 py-3 rounded-pill">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light text-primary fw-bold px-4 py-3 rounded-pill shadow">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Demo Profile
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light fw-semibold px-4 py-3 rounded-pill">
                        <i class="bi bi-person-plus me-1"></i> Create New Account
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-4 d-none d-lg-block text-center">
            <div class="p-4 bg-white bg-opacity-10 backdrop-blur rounded-4 border border-white border-opacity-25 shadow-lg">
                <i class="bi bi-shield-check display-2 text-warning mb-2"></i>
                <h5 class="fw-bold">Production Ready</h5>
                <p class="small text-light opacity-75 mb-0">Secure Authentication, CSRF Protection, Server & Client Validations, Dynamic Photo Uploads & Stored Procedures.</p>
            </div>
        </div>
    </div>
</div>

<!-- Key Features Grid -->
<div class="row g-4 mb-5">
    <div class="col-12 text-center mb-2">
        <h3 class="fw-bold">Key Architectural Features</h3>
        <p class="text-muted">Designed in compliance with ASP.NET Core & MVC best practices.</p>
    </div>

    <div class="col-md-4">
        <div class="custom-card p-4 h-100">
            <div class="d-inline-flex p-3 rounded-4 bg-primary-subtle text-primary mb-3">
                <i class="bi bi-person-bounding-box fs-3"></i>
            </div>
            <h5 class="fw-bold mb-2">Full Profile Management</h5>
            <p class="text-muted small mb-0">
                View and edit personal details, phone number, bio, address, date of birth, and avatar photos with instantaneous image preview.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="custom-card p-4 h-100">
            <div class="d-inline-flex p-3 rounded-4 bg-success-subtle text-success mb-3">
                <i class="bi bi-database-check fs-3"></i>
            </div>
            <h5 class="fw-bold mb-2">Optimized Database & SQL</h5>
            <p class="text-muted small mb-0">
                Normalized SQL Server relational database with primary/foreign keys, non-clustered indexes on emails/phones, and reusable stored procedures.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="custom-card p-4 h-100">
            <div class="d-inline-flex p-3 rounded-4 bg-warning-subtle text-warning mb-3">
                <i class="bi bi-shield-lock-fill fs-3"></i>
            </div>
            <h5 class="fw-bold mb-2">Security & Data Validation</h5>
            <p class="text-muted small mb-0">
                SHA-256 password hashing, Anti-CSRF token verification on all POST forms, safe file upload validation (whitelist & size check), and XSS prevention.
            </p>
        </div>
    </div>
</div>

<!-- Technology Stack Badges -->
<div class="custom-card p-4 mb-5 text-center">
    <h6 class="text-uppercase fw-bold text-secondary small mb-3">Technology Stack & Tools Utilized</h6>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-code-slash text-primary me-1"></i> C# / .NET 9.0</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-window-sidebar text-primary me-1"></i> ASP.NET Core MVC</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-hdd-network text-success me-1"></i> Entity Framework Core 9</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-database text-danger me-1"></i> Microsoft SQL Server</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-bootstrap-fill text-purple me-1"></i> Bootstrap 5 & Icons</span>
        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-git text-warning me-1"></i> Git Version Control</span>
    </div>
</div>
